[Unit]
Description=tgmsg full service healthcheck
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/data/tgmsg/current
Environment=TZ=Asia/Shanghai
Environment=HEALTHCHECK_TIMEZONE=Asia/Shanghai
TimeoutStartSec=120
ExecStart=/usr/bin/env bash /data/tgmsg/current/deploy/check-services.sh
