# =========================
# Telegram
# =========================
TG_API_ID=12345678
TG_API_HASH=your_telegram_api_hash
BOT_TOKEN=1234567890:your_bot_token
USERBOT_PHONE=+8613800000000

# =========================
# Security
# =========================
# 32-byte random key in Base64
ENCRYPTION_KEY=replace_with_base64_32byte_key
JWT_SECRET_KEY=replace_with_strong_jwt_secret
ADMIN_API_TOKEN=replace_with_admin_token

# =========================
# Shared Infra
# =========================
DATABASE_URL=postgresql+asyncpg://tgmsg:replace_with_pg_password@postgres:5432/tgmsg
REDIS_URL=redis://:replace_with_redis_password@redis:6379/0
INFRA_NETWORK_NAME=infra_default

# =========================
# App
# =========================
APP_PORT=8000
LOG_LEVEL=INFO
TIMEZONE=Asia/Shanghai
H5_BASE_URL=http://47.250.167.174
SERVE_FRONTEND=false
WORKER_INTERVAL=60
MAX_FAILURE_COUNT=5
APP_LOG_DIR=/data/tgmsg/shared/logs
APP_UPLOAD_DIR=/data/tgmsg/shared/uploads
NGINX_LOG_DIR=/data/tgmsg/shared/nginx-logs

# /bind rate-limit
BIND_MAX_FAILURES=8
BIND_FAILURE_WINDOW_SECONDS=600
BIND_LOCK_SECONDS=900
