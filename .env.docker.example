# =========================
# Telegram
# =========================
TG_API_ID=12345678
TG_API_HASH=your_telegram_api_hash
BOT_TOKEN=1234567890:your_bot_token
USERBOT_PHONE=+8613800000000

# =========================
# Security
# =========================
# 32-byte random key in Base64
ENCRYPTION_KEY=replace_with_base64_32byte_key
JWT_SECRET_KEY=replace_with_strong_jwt_secret
ADMIN_API_TOKEN=replace_with_admin_token
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=123456a.
ADMIN_BOOTSTRAP_DISPLAY_NAME=超级管理员

# =========================
# Shared Infra
# =========================
DATABASE_URL=postgresql+asyncpg://app_user:replace_with_shared_app_password@postgres:5432/tgmsg
REDIS_URL=redis://:replace_with_redis_password@redis:6379/0
INFRA_NETWORK_NAME=infra_default

# =========================
# App
# =========================
APP_ENV=production
APP_PORT=8000
LOG_LEVEL=INFO
TIMEZONE=Asia/Shanghai
PROVINCE_CODE=default
H5_BASE_URL=http://47.250.167.174
SERVE_FRONTEND=false
WORKER_INTERVAL=60
MAX_FAILURE_COUNT=5
APP_LOG_DIR=/data/tgmsg/logs
APP_UPLOAD_DIR=/data/tgmsg/uploads
TGMSG_APP_BIND_HOST=127.0.0.1
TGMSG_APP_HOST_PORT=18000
TGMSG_FRONTEND_STATIC_BASE_DIR=/data/infra/www/msg.telema.cn

# GHCR images
GHCR_USERNAME=your_github_username
GHCR_TOKEN=ghp_replace_with_read_packages_token

# /bind rate-limit
BIND_MAX_FAILURES=8
BIND_FAILURE_WINDOW_SECONDS=600
BIND_LOCK_SECONDS=900
