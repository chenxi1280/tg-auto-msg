# Telegram 配置
TG_API_ID=12345678
TG_API_HASH=your_telegram_api_hash
BOT_TOKEN=1234567890:your_bot_token
BOT_USERNAME=your_new_bot_username
USERBOT_PHONE=+8613800000000

# 数据库配置
DATABASE_URL=postgresql+asyncpg://postgres:password@127.0.0.1:5432/tgmsg
REDIS_URL=redis://:redis_password@127.0.0.1:6379/0

# 安全配置（务必在生产环境显式设置）
# ENCRYPTION_KEY 需要 32 字节随机值的 Base64 编码
ENCRYPTION_KEY=REPLACE_WITH_BASE64_32BYTE_KEY
# 轮换 ENCRYPTION_KEY 时，把旧密钥放在这里；多个旧密钥用英文逗号分隔，避免历史 session 无法解密
ENCRYPTION_KEY_FALLBACKS=
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ADMIN_API_TOKEN=CHANGE_ME_ADMIN_TOKEN
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_BOOTSTRAP_DISPLAY_NAME=超级管理员

# 应用配置
APP_ENV=production
LOG_LEVEL=INFO
TIMEZONE=Asia/Shanghai
H5_BASE_URL=https://msg.telema.cn

# 后端只绑定本机端口，由宿主机 Nginx 转发 /api、/docs、/redoc。
TGMSG_APP_BIND_HOST=127.0.0.1
TGMSG_APP_HOST_PORT=18000
# 防止单个业务容器内存异常拖垮整机；需要调整时必须显式修改。
TGMSG_APP_MEMORY_LIMIT=1g
# Docker JSON 日志轮转，避免高频连接错误无限占用磁盘。
TGMSG_APP_LOG_MAX_SIZE=50m
TGMSG_APP_LOG_MAX_FILES=3

# 前端静态文件由 GitHub Actions 构建镜像，服务器从镜像释放到该目录。
TGMSG_FRONTEND_STATIC_BASE_DIR=/data/infra/www/msg.telema.cn

# GHCR 拉取凭证，生产服务器 shared .env 建议配置，便于发布和回滚拉取镜像。
GHCR_USERNAME=your_github_username
GHCR_TOKEN=ghp_replace_with_read_packages_token

# 调度配置
WORKER_INTERVAL=60
MAX_FAILURE_COUNT=5
SCHEDULER_TASK_TIMEOUT_SECONDS=240
SCHEDULER_TASK_CONCURRENCY=3

# /bind 安全限流（防暴力猜码）
BIND_MAX_FAILURES=8
BIND_FAILURE_WINDOW_SECONDS=600
BIND_LOCK_SECONDS=900
BIND_START_COOLDOWN_SECONDS=120
PHONE_CODE_RESEND_FALLBACK_COOLDOWN_SECONDS=60
