FROM python:3.11-slim AS runtime

ARG DOCKER_CLI_VERSION=26.1.3
ARG DOCKER_COMPOSE_VERSION=v2.27.1

WORKDIR /app
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/backend
ENV TZ=Asia/Shanghai

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    ca-certificates \
    curl \
    tzdata \
    && ln -snf "/usr/share/zoneinfo/${TZ}" /etc/localtime \
    && echo "${TZ}" >/etc/timezone \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://download.docker.com/linux/static/stable/x86_64/docker-${DOCKER_CLI_VERSION}.tgz" \
    | tar -xz -C /tmp --strip-components=1 docker/docker \
    && mv /tmp/docker /usr/local/bin/docker \
    && chmod +x /usr/local/bin/docker

RUN mkdir -p /usr/local/lib/docker/cli-plugins \
    && curl -fsSL "https://github.com/docker/compose/releases/download/${DOCKER_COMPOSE_VERSION}/docker-compose-linux-x86_64" \
        -o /usr/local/lib/docker/cli-plugins/docker-compose \
    && chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
RUN pip install --no-cache-dir "passlib[bcrypt]>=1.7.4"

COPY backend /app/backend
COPY main.py /app/main.py
COPY sql /app/sql
COPY .env.example /app/.env.example

RUN mkdir -p /app/logs /app/uploads

EXPOSE 8000
CMD ["python", "main.py"]
